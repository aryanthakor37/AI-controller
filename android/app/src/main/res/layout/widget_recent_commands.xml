<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="🕒 Recent Commands"
        android:textColor="#A855F7"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/recent_cmd_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_button_bg"
        android:padding="6dp"
        android:text="⚡ 1. Turn on Flashlight"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/recent_cmd_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_button_bg"
        android:padding="6dp"
        android:text="⚡ 2. Open Camera"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/recent_cmd_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_button_bg"
        android:padding="6dp"
        android:text="⚡ 3. Check Weather"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

</LinearLayout>
